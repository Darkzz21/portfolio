---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Página no encontrada · Flavio" description="Esta página no existe. Volvé al portfolio de Flavio.">
  <main class="wrap">
    <p class="code">404</p>
    <h1>Esta página no existe</h1>
    <p>Puede que el link esté mal escrito o que la página se haya movido.</p>
    <a class="btn" href={base}>← Volver al portfolio</a>
  </main>
</Base>

<style>
  main { min-height: 100vh; display: grid; place-content: center; text-align: center; gap: 14px; }
  .code { font-size: clamp(5rem, 20vw, 9rem); font-weight: 900; line-height: 1; background: linear-gradient(90deg, var(--acento), var(--acento2), #b18cff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  h1 { font-size: clamp(1.5rem, 5vw, 2.2rem); }
  p { color: var(--suave); }
  .btn { justify-self: center; margin-top: 12px; background: var(--acento); color: #04130c; font-weight: 700; padding: 13px 24px; border-radius: 999px; transition: transform .25s, box-shadow .25s; }
  .btn:hover { transform: translateY(-3px); box-shadow: 0 10px 26px #3ddc9755; }
</style>
