---
import Base from '../layouts/Base.astro';

// ====== TUS DATOS (completá los links; los que queden vacíos no se muestran) ======
const NOMBRE = 'Flavio';
const ROL = 'Desarrollador y Diseñador Web';
const LINKEDIN = ''; // ej: 'https://www.linkedin.com/in/tu-usuario'
const GITHUB = '';   // ej: 'https://github.com/tu-usuario'
const EMAIL = '';    // ej: 'tunombre@mail.com'

// Para agregar un proyecto: copiá la carpeta en public/demos/<nombre>/ y sumá un objeto acá.
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // '/portfolio' en GitHub Pages
const proyectos = [
  {
    nombre: 'Forja Supps',
    rubro: 'E-commerce · Suplementos',
    desc: 'Tienda de suplementos con estética deportiva oscura, catálogo por categorías y pedido directo por WhatsApp desde cada producto.',
    url: `${base}/demos/suplementos/index.html`,
    tags: ['Catálogo', 'Dark UI', 'Animaciones'],
    color: '#ff6a1a',
  },
  {
    nombre: 'Prisma Dental',
    rubro: 'Salud · Consultorio',
    desc: 'Sitio para consultorio odontológico: transmite confianza, explica tratamientos y lleva a pedir turno en un clic.',
    url: `${base}/demos/odontologo/index.html`,
    tags: ['Landing', 'Turnos', 'SEO local'],
    color: '#2bb5a0',
  },
  {
    nombre: 'Nácar Estética',
    rubro: 'Belleza · Centro de estética',
    desc: 'Identidad cálida y editorial con tipografía serif, carta de tratamientos con precios y galería del espacio.',
    url: `${base}/demos/estetica/index.html`,
    tags: ['Branding', 'Galería', 'Reservas'],
    color: '#c7857a',
  },
  {
    nombre: 'HidroClima',
    rubro: 'Servicios · Plomería y A/A',
    desc: 'Pensado para urgencias desde el celular: barra fija de llamada y WhatsApp, servicios claros y zonas de cobertura.',
    url: `${base}/demos/servicio-tecnico/index.html`,
    tags: ['Mobile first', 'Click to call', 'Conversión'],
    color: '#0b64b0',
  },
];

const enfoque = [
  { t: 'Responsive real', d: 'Cada sitio se diseña y prueba en celular, tablet y escritorio, no solo se “achica”.' },
  { t: 'Rápido y liviano', d: 'HTML y CSS optimizados, sin dependencias innecesarias: carga en segundos.' },
  { t: 'Pensado para convertir', d: 'Llamados a la acción claros según el rubro: turno, pedido o llamada.' },
  { t: 'SEO y accesibilidad', d: 'Estructura semántica, metadatos y textos alternativos desde el inicio.' },
];

const stack = ['Astro', 'HTML5', 'CSS3', 'JavaScript', 'Diseño responsive', 'Git', 'Netlify'];

const contactos = [
  LINKEDIN && { label: 'LinkedIn', href: LINKEDIN },
  GITHUB && { label: 'GitHub', href: GITHUB },
  EMAIL && { label: 'Email', href: `mailto:${EMAIL}` },
].filter(Boolean) as { label: string; href: string }[];
---
<Base
  title={`${NOMBRE} | ${ROL} · Portfolio`}
  description={`Portfolio de ${NOMBRE}: sitios web responsive para negocios de distintos rubros.`}
>
  <header>
    <div class="wrap nav">
      <a class="logo" href="#top">{NOMBRE}<span>.</span></a>
      <nav>
        <a href="#proyectos">Proyectos</a>
        <a href="#enfoque">Enfoque</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </div>
  </header>

  <section class="hero" id="top">
    <div class="wrap">
      <p class="tag">Portfolio</p>
      <h1>Hola, soy {NOMBRE},<br /><span class="grad">{ROL}</span>.</h1>
      <p class="lead">
        Diseño y desarrollo sitios web modernos, rápidos y responsive, con foco en la experiencia
        de usuario y en los objetivos de cada negocio. Acá vas a encontrar una selección
        de proyectos para distintos rubros.
      </p>
      <div class="cta">
        <a class="btn" href="#proyectos">Ver proyectos</a>
        <a class="btn ghost" href="#contacto">Contacto</a>
      </div>
      <ul class="stats">
        <li><b>{proyectos.length}</b> proyectos</li>
        <li><b>100%</b> responsive</li>
        <li><b>4</b> rubros distintos</li>
      </ul>
    </div>
  </section>

  <section id="proyectos">
    <div class="wrap">
      <h2>Proyectos</h2>
      <p class="sub">Vista previa en vivo en escritorio y celular. Abrí cualquiera para recorrerlo completo.</p>

      <div class="proyectos">
        {proyectos.map((p, i) => (
          <article class="proyecto" style={`--c:${p.color}`}>
            <a class="mock" href={p.url} target="_blank" rel="noopener" aria-label={`Abrir ${p.nombre}`}>
              <div class="desk">
                <div class="bar"><i></i><i></i><i></i></div>
                <div class="screen" data-w="1280">
                  <iframe src={p.url} title={`${p.nombre} en escritorio`} loading="lazy" tabindex="-1" aria-hidden="true" width="1280" height="800"></iframe>
                </div>
              </div>
              <div class="phone">
                <div class="screen" data-w="390">
                  <iframe src={p.url} title={`${p.nombre} en celular`} loading="lazy" tabindex="-1" aria-hidden="true" width="390" height="844"></iframe>
                </div>
              </div>
            </a>
            <div class="info">
              <span class="num">0{i + 1}</span>
              <span class="rubro">{p.rubro}</span>
              <h3>{p.nombre}</h3>
              <p>{p.desc}</p>
              <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
              <a class="ver" href={p.url} target="_blank" rel="noopener">Ver sitio en vivo →</a>
            </div>
          </article>
        ))}
      </div>
      <p class="nota">Proyectos demostrativos: marcas, datos y precios son ficticios. Fotos de Unsplash.</p>
    </div>
  </section>

  <section class="alt" id="enfoque">
    <div class="wrap">
      <h2>Cómo trabajo</h2>
      <p class="sub">Lo que cuido en cada proyecto, más allá de que se vea lindo.</p>
      <div class="grid">
        {enfoque.map((e) => (
          <div class="card">
            <h3>{e.t}</h3>
            <p>{e.d}</p>
          </div>
        ))}
      </div>
      <h3 class="stack-t">Herramientas</h3>
      <ul class="stack">{stack.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <section class="cierre" id="contacto">
    <div class="wrap">
      <h2>Contacto</h2>
      <p>¿Querés conocer más sobre mi trabajo? Escribime.</p>
      {contactos.length > 0 ? (
        <div class="cta centro">
          {contactos.map((c) => <a class="btn ghost" href={c.href} target="_blank" rel="noopener">{c.label}</a>)}
        </div>
      ) : (
        <p class="nota">Completá LINKEDIN, GITHUB o EMAIL en src/pages/index.astro para mostrar tus links acá.</p>
      )}
    </div>
  </section>

  <footer><div class="wrap">© {new Date().getFullYear()} {NOMBRE} · Hecho con Astro</div></footer>

  <script>
    // Escala cada iframe para que la vista previa entre exacta en su marco
    const ajustar = (el: HTMLElement) => {
      const w = Number(el.dataset.w);
      el.style.setProperty('--s', String(el.clientWidth / w));
    };
    const ro = new ResizeObserver((es) => es.forEach((e) => ajustar(e.target as HTMLElement)));
    document.querySelectorAll<HTMLElement>('.screen').forEach((el) => { ajustar(el); ro.observe(el); });
  </script>
</Base>

<style>
  header { position: sticky; top: 0; background: #0b0f14ee; backdrop-filter: blur(8px); border-bottom: 1px solid var(--borde); z-index: 10; }
  .nav { display: flex; justify-content: space-between; align-items: center; height: 60px; }
  .logo { font-size: 1.15rem; font-weight: 800; }
  .logo span { color: var(--acento); }
  nav { display: flex; gap: 22px; font-size: .92rem; color: var(--suave); }
  nav a:hover { color: var(--texto); }

  .btn { display: inline-block; background: var(--acento); color: #04130c; font-weight: 700; padding: 13px 24px; border-radius: 999px; transition: transform .2s, box-shadow .2s, border-color .2s; }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 22px #3ddc9744; }
  .btn.ghost { background: transparent; color: var(--texto); border: 1px solid var(--borde); }
  .btn.ghost:hover { box-shadow: none; border-color: var(--acento); }

  .hero { padding: 100px 0 80px; background: radial-gradient(900px 400px at 80% -10%, #4da3ff22, transparent), radial-gradient(700px 400px at 0% 0%, #3ddc9722, transparent); }
  .tag { color: var(--acento); font-weight: 700; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 16px; }
  h1 { font-size: clamp(2rem, 5.5vw, 3.4rem); line-height: 1.12; max-width: 820px; }
  .grad { background: linear-gradient(90deg, var(--acento), var(--acento2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { color: var(--suave); font-size: 1.15rem; max-width: 580px; margin: 22px 0 32px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .cta.centro { justify-content: center; }
  .stats { list-style: none; display: flex; gap: 34px; flex-wrap: wrap; margin-top: 48px; color: var(--suave); font-size: .9rem; }
  .stats b { display: block; color: var(--texto); font-size: 1.6rem; }

  section { padding: 80px 0; }
  .alt { background: var(--panel); }
  h2 { font-size: clamp(1.6rem, 4vw, 2.1rem); margin-bottom: 8px; }
  .sub { color: var(--suave); margin-bottom: 36px; max-width: 580px; }

  /* ---- Proyectos ---- */
  .proyectos { display: grid; gap: 80px; }
  .proyecto { display: grid; grid-template-columns: 1.35fr 1fr; gap: 48px; align-items: center; }
  .proyecto:nth-child(even) .mock { order: 2; }
  .mock { position: relative; display: block; padding: 0 0 30px 0; }
  .desk { background: #1a222d; border: 1px solid var(--borde); border-radius: 12px; overflow: hidden; box-shadow: 0 30px 60px #0008, 0 0 0 1px #ffffff08; transition: transform .4s; }
  .mock:hover .desk { transform: translateY(-6px); }
  .bar { display: flex; gap: 6px; padding: 9px 12px; background: #141b24; }
  .bar i { width: 9px; height: 9px; border-radius: 50%; background: #2c3846; }
  .bar i:first-child { background: var(--c); }
  .screen { position: relative; overflow: hidden; background: #fff; }
  .desk .screen { aspect-ratio: 1280 / 800; }
  .screen iframe { position: absolute; top: 0; left: 0; border: 0; transform: scale(var(--s, .3)); transform-origin: 0 0; pointer-events: none; }
  .phone { position: absolute; right: -14px; bottom: 0; width: 26%; max-width: 150px; padding: 6px; background: #0b0f14; border: 2px solid #2c3846; border-radius: 22px; box-shadow: 0 20px 40px #000a; transition: transform .4s; }
  .mock:hover .phone { transform: translateY(-12px); }
  .phone .screen { aspect-ratio: 390 / 844; border-radius: 16px; }
  .proyecto:nth-child(even) .phone { right: auto; left: -14px; }

  .num { font-size: .85rem; font-weight: 800; color: var(--c); }
  .rubro { display: block; color: var(--suave); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; margin-top: 6px; }
  .info h3 { font-size: 1.8rem; margin: 4px 0 10px; }
  .info p { color: var(--suave); }
  .tags { list-style: none; display: flex; gap: 8px; flex-wrap: wrap; margin: 18px 0 20px; }
  .tags li { border: 1px solid var(--borde); border-radius: 999px; padding: 4px 12px; font-size: .8rem; color: var(--suave); }
  .ver { color: var(--c); font-weight: 700; }
  .ver:hover { text-decoration: underline; }
  .nota { margin-top: 48px; color: var(--suave); font-size: .85rem; }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }
  .card { background: var(--bg); border: 1px solid var(--borde); border-radius: 18px; padding: 24px; }
  .card h3 { margin-bottom: 6px; }
  .card p { color: var(--suave); font-size: .95rem; }
  .stack-t { margin: 44px 0 14px; font-size: 1.1rem; }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .stack li { background: var(--bg); border: 1px solid var(--borde); border-radius: 10px; padding: 8px 14px; font-size: .9rem; }

  .cierre { text-align: center; }
  .cierre p { color: var(--suave); margin: 8px 0 24px; }
  footer { padding: 24px 0; text-align: center; color: var(--suave); font-size: .85rem; border-top: 1px solid var(--borde); }

  @media (max-width: 820px) {
    .proyecto { grid-template-columns: 1fr; gap: 28px; }
    .proyecto:nth-child(even) .mock { order: 0; }
    .proyecto:nth-child(even) .phone { left: auto; right: -6px; }
    .phone { right: -6px; width: 28%; }
    .proyectos { gap: 64px; }
  }
  @media (max-width: 520px) {
    nav { gap: 14px; font-size: .85rem; }
    .hero { padding: 70px 0 60px; }
    section { padding: 60px 0; }
  }
</style>
