---
import Base from '../layouts/Base.astro';

// ====== TUS DATOS (completá los links; los que queden vacíos no se muestran) ======
const NOMBRE = 'Flavio';
const ROL = 'Desarrollador y Diseñador Web';
const LINKEDIN = ''; // ej: 'https://www.linkedin.com/in/tu-usuario'
const GITHUB = '';   // ej: 'https://github.com/tu-usuario'
const EMAIL = 'flavio.lovera@hotmail.com';
const TELEFONO = '+54 11 2524-1787';
const WHATSAPP = '5491125241787'; // código de país + 9 + número, sin espacios
const WA_URL = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent('Hola Flavio! Vi tu portfolio y quería contactarte.')}`;
const WA_ICON = '<svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.3.6 4.53 1.74 6.5L3 29l6.68-1.75A12.95 12.95 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3Zm0 23.66c-1.96 0-3.88-.53-5.56-1.52l-.4-.24-3.96 1.04 1.06-3.86-.26-.4A10.6 10.6 0 0 1 5.38 16c0-5.88 4.78-10.66 10.66-10.66S26.7 10.12 26.7 16s-4.78 10.66-10.66 10.66Zm5.85-7.98c-.32-.16-1.89-.93-2.18-1.04-.3-.1-.5-.16-.72.16-.21.32-.82 1.04-1.01 1.25-.18.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.22-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.14 3.08 1.3 3.3c.16.2 2.25 3.43 5.45 4.81.76.33 1.35.52 1.81.67.76.24 1.46.2 2.01.12.61-.09 1.89-.77 2.15-1.52.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37Z"/></svg>';

// Para agregar un proyecto: copiá la carpeta en public/demos/<nombre>/ y sumá un objeto acá.
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // '/portfolio' en GitHub Pages
const proyectos = [
  {
    nombre: 'Forja Supps',
    rubro: 'E-commerce · Suplementos',
    desc: 'Tienda de suplementos con estética deportiva oscura, catálogo por categorías y pedido directo por WhatsApp desde cada producto.',
    url: `${base}/demos/suplementos/index.html`,
    tags: ['Catálogo', 'Dark UI', 'Animaciones'],
    color: '#ff6a1a',
  },
  {
    nombre: 'Prisma Dental',
    rubro: 'Salud · Consultorio',
    desc: 'Sitio para consultorio odontológico: transmite confianza, explica tratamientos y lleva a pedir turno en un clic.',
    url: `${base}/demos/odontologo/index.html`,
    tags: ['Landing', 'Turnos', 'SEO local'],
    color: '#2bb5a0',
  },
  {
    nombre: 'Nácar Estética',
    rubro: 'Belleza · Centro de estética',
    desc: 'Identidad cálida y editorial con tipografía serif, carta de tratamientos con precios y galería del espacio.',
    url: `${base}/demos/estetica/index.html`,
    tags: ['Branding', 'Galería', 'Reservas'],
    color: '#c7857a',
  },
  {
    nombre: 'HidroClima',
    rubro: 'Servicios · Plomería y A/A',
    desc: 'Pensado para urgencias desde el celular: barra fija de llamada y WhatsApp, servicios claros y zonas de cobertura.',
    url: `${base}/demos/servicio-tecnico/index.html`,
    tags: ['Mobile first', 'Click to call', 'Conversión'],
    color: '#0b64b0',
  },
];

// Íconos de línea (SVG) para las tarjetas de "Cómo trabajo"
const ic = (d: string) => `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const enfoque = [
  { t: 'Responsive real', d: 'Cada sitio se diseña y prueba en celular, tablet y escritorio, no solo se “achica”.', i: ic('<rect x="2" y="4" width="14" height="10" rx="1.5"/><path d="M6 18h6"/><rect x="17" y="8" width="5" height="12" rx="1"/>') },
  { t: 'Rápido y liviano', d: 'HTML y CSS optimizados, sin dependencias innecesarias: carga en segundos.', i: ic('<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>') },
  { t: 'Pensado para convertir', d: 'Llamados a la acción claros según el rubro: turno, pedido o llamada.', i: ic('<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>') },
  { t: 'SEO y accesibilidad', d: 'Estructura semántica, metadatos y textos alternativos desde el inicio.', i: ic('<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>') },
];

// Habilidades agrupadas. "en" = dónde se puede ver aplicada en este portfolio.
const habilidades = [
  {
    cat: 'Desarrollo Front-end', color: '#4da3ff',
    resumen: 'Código limpio y semántico que funciona en cualquier navegador.',
    items: [
      { n: 'HTML5 semántico', d: 'Estructura clara para buscadores y lectores de pantalla.', en: 'Todas las demos' },
      { n: 'CSS3 · Flexbox y Grid', d: 'Layouts que se reacomodan solos según el tamaño de pantalla.', en: 'Grilla de productos de Forja Supps' },
      { n: 'Animaciones CSS', d: 'Transiciones y efectos al pasar el mouse, sin librerías pesadas.', en: 'Tarjetas y fotos de las demos' },
      { n: 'JavaScript (ES6+)', d: 'Interacciones y animaciones al hacer scroll con IntersectionObserver.', en: 'Aparición de secciones en las demos' },
      { n: 'Astro', d: 'Framework moderno para sitios estáticos ultrarrápidos.', en: 'Este portfolio' },
      { n: 'Componentes y datos', d: 'Contenido separado del diseño: sumar un proyecto es agregar una línea.', en: 'Lista de proyectos de este portfolio' },
      { n: 'Python', d: 'Scripts, automatización de tareas y procesamiento de datos.', en: '' },
    ],
  },
  {
    cat: 'Diseño Web · UI/UX', color: '#3ddc97',
    resumen: 'Interfaces con identidad propia, pensadas para el usuario.',
    items: [
      { n: 'Mobile first', d: 'Primero se diseña para el celular y después se amplía al escritorio.', en: 'Barra fija de llamada en HidroClima' },
      { n: 'Diseño de interfaces', d: 'Jerarquía visual, espaciados y componentes consistentes.', en: 'Las 4 demos' },
      { n: 'Color y tipografía', d: 'Cada marca con su propia paleta y tipografía según el rubro.', en: 'Estilo editorial serif de Nácar Estética' },
      { n: 'UX y conversión', d: 'Recorridos simples que llevan a la acción: turno, pedido o consulta.', en: 'Turnos por WhatsApp en Prisma Dental' },
      { n: 'Dirección de arte', d: 'Selección de fotografía y tratamiento con overlays y degradados.', en: 'Portadas de Forja Supps y HidroClima' },
      { n: 'Canva', d: 'Piezas gráficas, presentaciones y contenido para redes alineados a cada marca.', en: '' },
    ],
  },
  {
    cat: 'Optimización', color: '#ff9f1c',
    resumen: 'Sitios que cargan rápido y aparecen en Google.',
    items: [
      { n: 'SEO on-page', d: 'Títulos, descripciones y estructura pensados para buscadores.', en: 'Metadatos de cada demo' },
      { n: 'Accesibilidad', d: 'Contraste, textos alternativos y etiquetas para lectores de pantalla.', en: 'Imágenes y botones de las demos' },
      { n: 'Performance', d: 'Imágenes optimizadas y carga diferida (lazy loading).', en: 'Fotos y vistas previas de este portfolio' },
    ],
  },
  {
    cat: 'Herramientas y flujo', color: '#b18cff',
    resumen: 'Trabajo ordenado, versionado y con publicación automática.',
    items: [
      { n: 'Git', d: 'Control de versiones: cada cambio queda registrado.', en: 'Historial de este proyecto' },
      { n: 'GitHub', d: 'Repositorios y código público para mostrar mi trabajo.', en: 'github.com/Darkzz21/portfolio' },
      { n: 'GitHub Actions + Pages', d: 'Publicación automática en cada actualización.', en: 'Este portfolio se publica solo' },
      { n: 'npm', d: 'Gestión de dependencias y scripts de compilación.', en: 'Build de este portfolio' },
      { n: 'IA · Claude Pro', d: 'Desarrollo asistido por IA para programar, revisar código e iterar más rápido.', en: 'Desarrollo de este portfolio' },
    ],
  },
];

const contactos = [
  LINKEDIN && { label: 'LinkedIn', href: LINKEDIN },
  GITHUB && { label: 'GitHub', href: GITHUB },
].filter(Boolean) as { label: string; href: string }[];
---
<Base
  title={`${NOMBRE} | ${ROL} · Portfolio`}
  description={`Portfolio de ${NOMBRE}: sitios web responsive para negocios de distintos rubros.`}
>
  <div class="luz" aria-hidden="true"></div>

  <header>
    <div class="wrap nav">
      <a class="logo" href="#top">{NOMBRE}<span>.</span></a>
      <nav>
        <a href="#proyectos" style="--c:#ff6a1a">Proyectos</a>
        <a href="#habilidades" style="--c:#4da3ff">Habilidades</a>
        <a href="#contacto" style="--c:#3ddc97">Contacto</a>
      </nav>
    </div>
    <div class="progreso" aria-hidden="true"></div>
  </header>

  <section class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="rv">
        <p class="tag"><span class="pulso"></span>Portfolio · disponible para proyectos</p>
        <h1>Hola, soy {NOMBRE},<br /><span class="grad">{ROL}</span>.</h1>
        <p class="lead">
          Diseño y desarrollo sitios web modernos, rápidos y responsive, con foco en la experiencia
          de usuario y en los objetivos de cada negocio. Acá vas a encontrar una selección
          de proyectos para distintos rubros.
        </p>
        <div class="cta">
          <a class="btn" href="#proyectos">Ver proyectos</a>
          <a class="btn ghost" href="#contacto">Contacto</a>
        </div>
      </div>

      <div class="glow code rv" style="--c:#4da3ff" aria-label={`${NOMBRE}: ${ROL}`}>
        <div class="code-bar"><i></i><i></i><i></i><span>flavio.js</span></div>
        <pre><code><span class="k">const</span> <span class="v">flavio</span> = {'{'}
  <span class="p">rol</span>: <span class="s">'{ROL}'</span>,
  <span class="p">stack</span>: [<span class="s">'HTML'</span>, <span class="s">'CSS'</span>, <span class="s">'JavaScript'</span>,
          <span class="s">'Astro'</span>, <span class="s">'Python'</span>],
  <span class="p">diseño</span>: [<span class="s">'UI/UX'</span>, <span class="s">'Canva'</span>],
  <span class="p">ia</span>: <span class="s">'Claude Pro'</span>,
  <span class="p">proyectos</span>: <span class="n">{proyectos.length}</span>,
  <span class="p">disponible</span>: <span class="k">true</span>,
{'}'};<span class="cursor"></span></code></pre>
      </div>
    </div>

    <div class="wrap">
      <ul class="stats">
        <li class="glow stat rv" style="--c:#ff6a1a"><b data-n={proyectos.length}>{proyectos.length}</b><span>proyectos</span></li>
        <li class="glow stat rv" style="--c:#3ddc97"><b data-n="100" data-suf="%">100%</b><span>responsive</span></li>
        <li class="glow stat rv" style="--c:#4da3ff"><b data-n={habilidades.reduce((n, h) => n + h.items.length, 0)}>{habilidades.reduce((n, h) => n + h.items.length, 0)}</b><span>habilidades</span></li>
        <li class="glow stat rv" style="--c:#b18cff"><b data-n="4">4</b><span>rubros distintos</span></li>
      </ul>
    </div>
  </section>

  <section id="proyectos">
    <div class="wrap">
      <p class="kicker rv" style="--c:#ff6a1a">01 — Trabajo</p>
      <h2 class="rv">Proyectos</h2>
      <p class="sub rv">Vista previa en vivo en escritorio y celular. Mové el mouse sobre cada una o abrila para recorrerla completa.</p>

      <div class="proyectos">
        {proyectos.map((p, i) => (
          <article class="proyecto rv" style={`--c:${p.color}`}>
            <a class="mock" href={p.url} target="_blank" rel="noopener" aria-label={`Abrir ${p.nombre}`}>
              <div class="desk">
                <div class="bar"><i></i><i></i><i></i></div>
                <div class="screen" data-w="1280">
                  <iframe src={p.url} title={`${p.nombre} en escritorio`} loading="lazy" tabindex="-1" aria-hidden="true" width="1280" height="800"></iframe>
                </div>
              </div>
              <div class="phone">
                <div class="screen" data-w="390">
                  <iframe src={p.url} title={`${p.nombre} en celular`} loading="lazy" tabindex="-1" aria-hidden="true" width="390" height="844"></iframe>
                </div>
              </div>
            </a>
            <div class="glow info">
              <span class="num">0{i + 1}</span>
              <span class="rubro">{p.rubro}</span>
              <h3>{p.nombre}</h3>
              <p>{p.desc}</p>
              <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
              <a class="ver" href={p.url} target="_blank" rel="noopener">Ver sitio en vivo <span>→</span></a>
            </div>
          </article>
        ))}
      </div>
      <p class="nota rv">Proyectos demostrativos: marcas, datos y precios son ficticios. Fotos de Unsplash.</p>
    </div>
  </section>

  <section class="alt" id="habilidades">
    <div class="wrap">
      <p class="kicker rv" style="--c:#4da3ff">02 — Lo que sé hacer</p>
      <h2 class="rv">Habilidades</h2>
      <p class="sub rv">Lo que sé hacer y dónde lo apliqué. Pasá el mouse (o tocá) cada habilidad para ver el detalle.</p>
      <div class="skills">
        {habilidades.map((h) => (
          <div class="glow skill-cat rv" style={`--c:${h.color}`}>
            <h3><span class="dot"></span>{h.cat}</h3>
            <ul class="chips">
              {h.items.map((s) => (
                <li><button type="button" class="chip" data-d={s.d} data-en={s.en}>{s.n}</button></li>
              ))}
            </ul>
            <div class="detalle" aria-live="polite">
              <p class="d-txt">{h.resumen}</p>
              <p class="d-en"></p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="enfoque">
    <div class="wrap">
      <p class="kicker rv" style="--c:#b18cff">03 — Enfoque</p>
      <h2 class="rv">Cómo trabajo</h2>
      <p class="sub rv">Lo que cuido en cada proyecto, más allá de que se vea lindo.</p>
      <div class="grid">
        {enfoque.map((e, i) => (
          <div class="glow card rv" style={`--c:${['#4da3ff', '#ff9f1c', '#3ddc97', '#b18cff'][i]}`}>
            <span class="icono"><Fragment set:html={e.i} /></span>
            <h3>{e.t}</h3>
            <p>{e.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt cierre" id="contacto">
    <div class="wrap">
      <div class="glow contacto rv" style="--c:#3ddc97">
        <p class="kicker" style="--c:#3ddc97">04 — Contacto</p>
        <h2>Hablemos</h2>
        <p>¿Tenés un proyecto en mente o querés conocer más sobre mi trabajo? Escribime.</p>
        <div class="cta centro">
          <a class="btn wa-btn" href={WA_URL} target="_blank" rel="noopener"><Fragment set:html={WA_ICON} /> Escribime por WhatsApp</a>
          {contactos.map((c) => <a class="btn ghost" href={c.href} target="_blank" rel="noopener">{c.label}</a>)}
        </div>
        <div class="datos">
          <a class="glow dato" style="--c:#4da3ff" href={`mailto:${EMAIL}`}>
            <span class="icono"><Fragment set:html={ic('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>')} /></span>
            <span><small>Email</small>{EMAIL}</span>
          </a>
          <a class="glow dato" style="--c:#ff9f1c" href={`tel:${TELEFONO.replace(/[^+\d]/g, '')}`}>
            <span class="icono"><Fragment set:html={ic('<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>')} /></span>
            <span><small>Teléfono</small>{TELEFONO}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <a class="wa-float" href={WA_URL} target="_blank" rel="noopener" aria-label="Escribime por WhatsApp"><Fragment set:html={WA_ICON} /></a>

  <footer><div class="wrap">© {new Date().getFullYear()} {NOMBRE} · Hecho con Astro</div></footer>

  <script>
    // Escala cada iframe para que la vista previa entre exacta en su marco
    const ajustar = (el: HTMLElement) => {
      const w = Number(el.dataset.w);
      el.style.setProperty('--s', String(el.clientWidth / w));
    };
    const ro = new ResizeObserver((es) => es.forEach((e) => ajustar(e.target as HTMLElement)));
    document.querySelectorAll<HTMLElement>('.screen').forEach((el) => { ajustar(el); ro.observe(el); });

    // Brillo que sigue al mouse en las tarjetas
    document.querySelectorAll<HTMLElement>('.glow').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--x', `${e.clientX - r.left}px`);
        el.style.setProperty('--y', `${e.clientY - r.top}px`);
      });
    });

    const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fino = matchMedia('(pointer: fine)').matches;

    // Aparición suave al hacer scroll
    document.documentElement.classList.add('rv-on');
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));

    // Contadores animados en la portada
    document.querySelectorAll<HTMLElement>('.stat b').forEach((b) => {
      const fin = Number(b.dataset.n); const suf = b.dataset.suf || '';
      if (calmo) return;
      const obs = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return; obs.disconnect();
        const t0 = performance.now();
        const paso = (t: number) => {
          const k = Math.min(1, (t - t0) / 1200);
          b.textContent = Math.round(fin * (1 - Math.pow(1 - k, 3))) + suf;
          if (k < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
      });
      obs.observe(b);
    });

    // Barra de progreso de lectura
    const barra = document.querySelector<HTMLElement>('.progreso')!;
    const progreso = () => {
      const h = document.documentElement.scrollHeight - innerHeight;
      barra.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`;
    };
    addEventListener('scroll', progreso, { passive: true }); progreso();

    // Resaltar en el menú la sección visible
    const links = [...document.querySelectorAll<HTMLAnchorElement>('nav a')];
    const secciones = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.toggle('activo', a.hash === `#${e.target.id}`));
    }), { rootMargin: '-45% 0px -50% 0px' });
    ['top', 'proyectos', 'habilidades', 'enfoque', 'contacto'].forEach((id) => {
      const s = document.getElementById(id); if (s) secciones.observe(s);
    });

    if (fino && !calmo) {
      // Luz ambiental que sigue al cursor
      const luz = document.querySelector<HTMLElement>('.luz')!;
      addEventListener('pointermove', (e) => {
        luz.style.setProperty('--mx', `${e.clientX}px`);
        luz.style.setProperty('--my', `${e.clientY}px`);
        luz.style.opacity = '1';
      }, { passive: true });

      // Inclinación 3D de las vistas previas
      document.querySelectorAll<HTMLElement>('.mock').forEach((m) => {
        m.addEventListener('pointermove', (e) => {
          const r = m.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          m.style.setProperty('--ry', `${x * 10}deg`);
          m.style.setProperty('--rx', `${-y * 8}deg`);
        });
        m.addEventListener('pointerleave', () => { m.style.setProperty('--ry', '0deg'); m.style.setProperty('--rx', '0deg'); });
      });
    }

    // Detalle de cada habilidad al pasar el mouse, enfocar o tocar
    document.querySelectorAll<HTMLElement>('.skill-cat').forEach((cat) => {
      const txt = cat.querySelector<HTMLElement>('.d-txt')!;
      const en = cat.querySelector<HTMLElement>('.d-en')!;
      const resumen = txt.textContent;
      const chips = cat.querySelectorAll<HTMLButtonElement>('.chip');
      const mostrar = (c: HTMLButtonElement | null) => {
        chips.forEach((x) => x.classList.toggle('on', x === c));
        txt.textContent = c ? c.dataset.d! : resumen;
        en.textContent = c && c.dataset.en ? `Aplicado en: ${c.dataset.en}` : '';
        cat.classList.toggle('activa', !!c);
      };
      chips.forEach((c) => {
        c.addEventListener('mouseenter', () => mostrar(c));
        c.addEventListener('focus', () => mostrar(c));
        c.addEventListener('click', () => mostrar(c));
      });
      cat.addEventListener('mouseleave', () => mostrar(null));
    });
  </script>
</Base>

<style>
  /* ---- Ambiente ---- */
  .luz { position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: 0; transition: opacity .6s; background: radial-gradient(600px circle at var(--mx, 50%) var(--my, 30%), #4da3ff0f, transparent 60%); }
  section, footer { position: relative; z-index: 1; }

  /* Aparición al hacer scroll (solo si hay JS) */
  :global(.rv-on) .rv { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.8,.2,1); }
  :global(.rv-on) .rv.in { opacity: 1; transform: none; }
  .grid .rv:nth-child(2), .skills .rv:nth-child(2), .stats .rv:nth-child(2) { transition-delay: .08s; }
  .grid .rv:nth-child(3), .skills .rv:nth-child(3), .stats .rv:nth-child(3) { transition-delay: .16s; }
  .grid .rv:nth-child(4), .skills .rv:nth-child(4), .stats .rv:nth-child(4) { transition-delay: .24s; }

